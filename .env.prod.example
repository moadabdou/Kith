# ==============================================================================
# Kith - Production Environment Configuration (.env.prod)
# Domain: https://kith.moadabdou.me
# Target: Oracle Cloud Ampere ARM64 VM (11GB RAM Budget)
# ==============================================================================

# ------------------------------------------------------------------------------
# General & Application URLs
# ------------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
CHAOS_ENABLED=false
APP_URL=https://kith.moadabdou.me
VITE_API_BASE=/api
VITE_GATEWAY_WS=wss://kith.moadabdou.me/ws

# ------------------------------------------------------------------------------
# Core Security & Authentication
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-very-secure-random-32-byte-hex-secret
ERLANG_COOKIE=change-this-to-a-secure-erlang-cookie-secret

# ------------------------------------------------------------------------------
# PostgreSQL Configuration (Tuned: shared_buffers=512MB)
# ------------------------------------------------------------------------------
POSTGRES_USER=kith_prod
POSTGRES_PASSWORD=change-this-postgres-secure-password
POSTGRES_DB=kith_prod
PG_POOL_MAX_OPEN_CONNS=25
PG_POOL_MAX_IDLE_CONNS=25
PG_POOL_MAX_LIFETIME_SEC=300

# ------------------------------------------------------------------------------
# Redis & NATS Messaging
# ------------------------------------------------------------------------------
EVENTS_BUS=nats
BUS_TYPE=nats
REDIS_URL=redis://redis:6379
NATS_URL=nats://nats:4222

# ------------------------------------------------------------------------------
# ScyllaDB Message Store (Tuned: 2.5GB memory cap)
# ------------------------------------------------------------------------------
SCYLLA_HOSTS=scylla:9042
SCYLLA_KEYSPACE=kith
SCYLLA_CONSISTENCY=ONE
MESSAGE_STORE=scylla
MESSAGES_STORE_MODE=scylla_only
API_MSG_MAX_INFLIGHT=100

# ------------------------------------------------------------------------------
# Meilisearch (Tuned: 512MB memory cap)
# Generate master key with: openssl rand -hex 16
# ------------------------------------------------------------------------------
MEILI_MASTER_KEY=change-this-to-a-secure-meili-master-key-16-bytes
MEILI_ENV=production
SEARCH_INDEXER_ENABLED=true

# ------------------------------------------------------------------------------
# Object Storage (MinIO / S3) & Media Processing
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=kith_admin
MINIO_ROOT_PASSWORD=change-this-to-a-secure-minio-password-at-least-16-chars
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=kith_admin
S3_SECRET_KEY=change-this-to-a-secure-minio-password-at-least-16-chars
S3_BUCKET_ATTACHMENTS=attachments
S3_BUCKET_AVATARS=avatars
S3_USE_SSL=false
S3_PUBLIC_URL=https://kith.moadabdou.me
S3_PUBLIC_ENDPOINT=kith.moadabdou.me
MAX_UPLOAD_BYTES=52428800

# ------------------------------------------------------------------------------
# Voice & SFU / WebRTC Configuration
# NAT_1TO1_IPS must be set to the VM public IP
# ------------------------------------------------------------------------------
NAT_1TO1_IPS=51.170.129.228
STUN_SERVER=stun:stun.cloudflare.com:3478
VOICE_SFU_POOL=sfu:5000,sfu-2:5001
SFU_UDP_PORT_MIN=50000
SFU_UDP_PORT_MAX=50200
SFU2_UDP_PORT_MIN=50300
SFU2_UDP_PORT_MAX=50320
SFU_LOG_LEVEL=warn
SFU_PION_LOG=warn

# ------------------------------------------------------------------------------
# Read States Service
# ------------------------------------------------------------------------------
READ_STATES_PORT=8085

# ------------------------------------------------------------------------------
# Resource Tuning Flags (11GB VM Budget)
# ------------------------------------------------------------------------------
GOMEMLIMIT=1GiB
GOGC=100
ERL_FLAGS=+MBas 1024
RAYON_NUM_THREADS=2

# ------------------------------------------------------------------------------
# Ports & Node Identifiers
# ------------------------------------------------------------------------------
API_PORT=8082
API2_PORT=8083
GATEWAY_PORT=4000
GATEWAY2_PORT=4001
SNOWFLAKE_NODE_ID=1
SNOWFLAKE_NODE_ID_2=2
PRESENCE_IDLE_THRESHOLD_MS=120000

# Optional 3rd party integrations
KLIPY_API_KEY=
OUTBOUND_PROXY_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
